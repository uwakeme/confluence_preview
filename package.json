{
  "name": "confluence-previewer",
  "displayName": "Confluence Previewer",
  "description": "Preview Confluence Storage Format (Source Editor XHTML) as it appears in Confluence",
  "icon": "image/icon.png",
  "version": "0.2.0",
  "publisher": "wake",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uwakeme/confluence_preview.git"
  },
  "bugs": {
    "url": "https://github.com/uwakeme/confluence_preview/issues"
  },
  "homepage": "https://github.com/uwakeme/confluence_preview#readme",
  "keywords": [
    "confluence",
    "preview",
    "jira",
    "storage-format",
    "wiki"
  ],
  "activationEvents": [
    "onLanguage:confluence",
    "onLanguage:html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "confluence",
        "aliases": [
          "Confluence",
          "Confluence Storage Format"
        ],
        "filenamePatterns": [
          "**/*.confluence",
          "**/*.cfl",
          "**/*.confluence-storage"
        ],
        "configuration": "./confluence.configuration.json"
      }
    ],
    "commands": [
      {
        "command": "confluence-previewer.openPreview",
        "title": "%command.openPreview%",
        "category": "Confluence",
        "icon": "$(open-preview)"
      },
      {
        "command": "confluence-previewer.copyHtml",
        "title": "%command.copyHtml%",
        "category": "Confluence"
      },
      {
        "command": "confluence-previewer.exportMarkdown",
        "title": "%command.exportMarkdown%",
        "category": "Confluence"
      },
      {
        "command": "confluence-previewer.exportHtml",
        "title": "%command.exportHtml%",
        "category": "Confluence"
      },
      {
        "command": "confluence-previewer.refresh",
        "title": "%command.refresh%",
        "category": "Confluence",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "confluence-previewer.openPreview",
          "when": "editorLangId == confluence || (editorLangId == html && confluence-previewer.enableForHtml)",
          "group": "navigation"
        },
        {
          "command": "confluence-previewer.refresh",
          "when": "confluence-previewer.previewActive && (editorLangId == confluence || (editorLangId == html && confluence-previewer.enableForHtml))",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "confluence-previewer.openPreview",
          "when": "editorLangId == confluence || (editorLangId == html && confluence-previewer.enableForHtml)",
          "group": "confluence@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "confluence-previewer.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == confluence || (editorLangId == html && confluence-previewer.enableForHtml)"
      }
    ],
    "configuration": {
      "title": "Confluence Previewer",
      "properties": {
        "confluence-previewer.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.baseUrl%"
        },
        "confluence-previewer.jiraBaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.jiraBaseUrl%"
        },
        "confluence-previewer.localFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.localFiles%"
        },
        "confluence-previewer.refreshDebounce": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "markdownDescription": "%config.refreshDebounce%"
        },
        "confluence-previewer.outlineVisible": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.outlineVisible%"
        },
        "confluence-previewer.enableForHtml": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.enableForHtml%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "pretest": "esbuild src/parser/index.ts --bundle --platform=node --format=esm --outfile=tests/parser.bundle.mjs --log-level=warning",
    "test": "node --test \"tests/*.test.mjs\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.4",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "cheerio": "1.0.0-rc.12"
  }
}